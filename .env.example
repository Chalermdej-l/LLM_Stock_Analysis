# Replace every CHANGE_ME before running.
API_KEY=CHANGE_ME # Groq API key: https://console.groq.com/keys
PROJECT_ID=CHANGE_ME # GCP project id: https://console.cloud.google.com/
MAGIC_USER=CHANGE_ME # Magic Formula Investing email
MAGIC_PW=CHANGE_ME # Magic Formula Investing password
MODEL=CHANGE_ME # Groq model id for the report pipeline (pick a current, non-deprecated id)
MODEL_TOOL=CHANGE_ME # Groq model id for the SQL tool-calling agent (pick a current, non-deprecated id)
SEC_USER_AGENT=CHANGE_ME # SEC fair-access User-Agent, e.g. "Acme Research admin@acme.com"

# Keep these unless you change the deployment.
REGION_NAME=asia-southeast1
DATABASE_NAME=llm-stock-db
SQL_HOST=cloud-sql-proxy
SQL_DATABASE=postgres
SQL_USER=admin
SQL_PASSWORD=CHANGE_ME
SQL_READONLY_USER=chat_readonly
SQL_READONLY_PASSWORD=CHANGE_ME # read-only role used by the chat UI's SQL tool
SQL_PORT=5432
CHAINLIT_AUTH_SECRET=CHANGE_ME
CHAINLIT_AUTH_USERNAME=CHANGE_ME
CHAINLIT_AUTH_PASSWORD=CHANGE_ME
